{
  "info": {
    "_postman_id": "nexoshop-api-collection",
    "name": "NexoShop API",
    "description": "Colección de la API académica local de NexoShop. La URL se configura mediante {{baseUrl}}. No utiliza autenticación ni JWT. Requiere PostgreSQL y Spring Boot activos; el flujo principal crea datos reales en la base local. Nunca almacenes credenciales reales en esta colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Flujo principal",
      "description": "Flujo secuencial: usuario, categoría, producto, carrito, checkout, pedido, pago simulado y logística.",
      "item": [
        {
          "name": "01 Registrar usuario demo",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"demo.{{runId}}@example.com\",\n  \"password\": \"DemoPass!42\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users", "description": "Genera runId antes de registrar un usuario ficticio." },
          "event": [
            { "listen": "prerequest", "script": { "type": "text", "exec": ["const runId = String(Date.now()) + String(Math.floor(Math.random() * 900 + 100));", "pm.environment.set('runId', runId);"] } },
            { "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });", "const body = pm.response.json();", "pm.test('Usuario sin datos sensibles', function () { pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body).to.not.have.property('password'); pm.expect(body).to.not.have.property('passwordHash'); pm.expect(pm.response.headers.get('Location')).to.be.ok; });", "if (!body.id || typeof body.id !== 'number' || body.id <= 0) { throw new Error('No se recibió userId positivo'); }", "pm.environment.set('userId', String(body.id));"] } }
          ]
        },
        {
          "name": "02 Crear categoría demo",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria Demo {{runId}}\",\n  \"description\": \"Categoría ficticia para la ejecución\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/categories", "description": "Crea una categoría activa con nombre único por ejecución." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Categoría y Location', function () { pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body.active).to.eql(true); pm.expect(pm.response.headers.get('Location')).to.be.ok; });", "if (!body.id || typeof body.id !== 'number' || body.id <= 0) { throw new Error('No se recibió categoryId positivo'); }", "pm.environment.set('categoryId', String(body.id));"] } }]
        },
        {
          "name": "03 Crear producto con stock",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"sku\": \"NS-{{runId}}\",\n  \"name\": \"Producto Demo {{runId}}\",\n  \"description\": \"Producto ficticio para el flujo principal\",\n  \"price\": 49.90,\n  \"stock\": 20,\n  \"imageUrl\": \"https://example.test/product.jpg\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/products", "description": "Crea un producto activo con stock suficiente para checkout y cancelación." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Producto activo y con stock', function () { pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body.active).to.eql(true); pm.expect(body.stock).to.be.at.least(20); });", "if (!body.id || typeof body.id !== 'number' || body.id <= 0) { throw new Error('No se recibió productId positivo'); }", "pm.environment.set('productId', String(body.id));", "pm.environment.set('sku', body.sku);"] } }]
        },
        {
          "name": "04 Obtener o crear carrito",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/cart", "description": "Obtiene el carrito del usuario activo y captura cartId." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Carrito válido', function () { pm.expect(body.cartId).to.be.a('number').and.above(0); pm.expect(body.userId).to.be.a('number').and.above(0); pm.expect(body.items).to.be.an('array'); });", "if (!body.cartId || typeof body.cartId !== 'number' || body.cartId <= 0) { throw new Error('No se recibió cartId positivo'); }", "pm.environment.set('cartId', String(body.cartId));"] } }]
        },
        {
          "name": "05 Agregar producto al carrito",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users/{{userId}}/cart/items", "description": "Agrega una unidad del producto activo." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Carrito con artículos', function () { pm.expect(body.items).to.be.an('array').and.not.empty; pm.expect(body.totalUnits).to.be.above(0); });"] } }]
        },
        {
          "name": "06 Actualizar cantidad del carrito",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users/{{userId}}/cart/items/{{productId}}", "description": "Establece la cantidad antes del checkout." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Cantidad actualizada', function () { pm.expect(body.items).to.be.an('array').and.not.empty; pm.expect(body.items[0].quantity).to.eql(1); });"] } }]
        },
        {
          "name": "07 Ejecutar checkout",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"paymentMethod\": \"CASH_ON_DELIVERY\",\n  \"shippingCost\": 5.00,\n  \"recipientName\": \"Ada Lovelace\",\n  \"recipientPhone\": \"+595 21 555000\",\n  \"shippingAddress\": \"Calle Demo 123\",\n  \"shippingCity\": \"Asuncion\",\n  \"shippingReference\": \"Edificio Demo\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/checkout", "description": "Crea el pedido PENDING, descuenta stock y vacía el carrito." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Pedido PENDING', function () { pm.expect(body.orderId).to.be.a('number').and.above(0); pm.expect(body.status).to.eql('PENDING'); pm.expect(body.paymentStatus).to.eql('PENDING'); pm.expect(body.items).to.be.an('array').and.not.empty; });", "if (!body.orderId || typeof body.orderId !== 'number' || body.orderId <= 0) { throw new Error('No se recibió orderId positivo'); }", "pm.environment.set('orderId', String(body.orderId));"] } }]
        },
        {
          "name": "08 Consultar pedido creado",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}", "description": "Comprueba el pedido y sus snapshots históricos." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Pedido consultable', function () { pm.expect(body.orderId).to.eql(Number(pm.environment.get('orderId'))); pm.expect(body.items).to.be.an('array').and.not.empty; pm.expect(body.subtotal).to.be.a('number'); pm.expect(body.total).to.be.a('number'); });"] } }]
        },
        {
          "name": "09 Confirmar pedido",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/confirm", "description": "Transición PENDING -> CONFIRMED." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Pedido confirmado', function () { pm.expect(body.status).to.eql('CONFIRMED'); pm.expect(body.items).to.be.an('array').and.not.empty; });"] } }]
        },
        {
          "name": "10 Listar pedidos",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/orders?page={{page}}&size={{size}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "orders"], "query": [{ "key": "page", "value": "{{page}}", "disabled": false }, { "key": "size", "value": "{{size}}", "disabled": false }] }, "description": "Lista pedidos del usuario con paginación real." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.test('Respuesta paginada', function () { pm.expect(body.content).to.be.an('array'); pm.expect(body).to.have.property('page'); pm.expect(body).to.have.property('totalElements'); pm.expect(body).to.have.property('totalPages'); });"] } }]
        },
        {
          "name": "11 Marcar pago fallido",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/payment/failed", "description": "Transición de pago PENDING -> FAILED." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().paymentStatus).to.eql('FAILED');"] } }]
        },
        {
          "name": "12 Recuperar pago",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/payment/paid", "description": "Transición de reintento FAILED -> PAID." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().paymentStatus).to.eql('PAID');"] } }]
        },
        {
          "name": "13 Reembolsar pago",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/payment/refund", "description": "Transición de pago PAID -> REFUNDED." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().paymentStatus).to.eql('REFUNDED');"] } }]
        },
        {
          "name": "14 Pasar a preparación",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/preparing", "description": "Transición CONFIRMED -> PREPARING." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().status).to.eql('PREPARING');"] } }]
        },
        {
          "name": "15 Enviar pedido",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/ship", "description": "Transición PREPARING -> SHIPPED." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().status).to.eql('SHIPPED');"] } }]
        },
        {
          "name": "16 Entregar pedido",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/orders/{{orderId}}/deliver", "description": "Transición SHIPPED -> DELIVERED." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().status).to.eql('DELIVERED');"] } }]
        }
      ]
    },
    {
      "name": "01 - Users",
      "description": "Las dos operaciones reales del controlador de usuarios.",
      "item": [
        {
          "name": "Registrar usuario",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"reference.{{runId}}@example.com\",\n  \"password\": \"DemoPass!42\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users", "description": "POST /users; devuelve 201, Location y UserResponse sin contraseña." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body).to.not.have.property('passwordHash'); pm.expect(pm.response.headers.get('Location')).to.be.ok;", "pm.environment.set('userId', String(body.id));"] } }]
        },
        {
          "name": "Consultar usuario",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}", "description": "GET /users/{id}; devuelve UserResponse sin datos sensibles." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body).to.not.have.property('password'); pm.expect(body).to.not.have.property('passwordHash');"] } }]
        }
      ]
    },
    {
      "name": "02 - Categories",
      "description": "Las seis operaciones reales del controlador de categorías.",
      "item": [
        {
          "name": "Crear categoría",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria Ref {{runId}}\",\n  \"description\": \"Categoría de referencia\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/categories", "description": "POST /categories; name requerido, máximo 100 caracteres." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(pm.response.headers.get('Location')).to.be.ok;", "pm.environment.set('categoryId', String(body.id));"] } }]
        },
        {
          "name": "Actualizar categoría",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria Ref Actualizada {{runId}}\",\n  \"description\": \"Descripción actualizada\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}", "description": "PUT /categories/{id}; actualiza nombre y descripción." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body.name).to.include('Actualizada');"] } }]
        },
        {
          "name": "Consultar categoría",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}", "description": "GET /categories/{id}." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().id).to.be.a('number').and.above(0);"] } }]
        },
        {
          "name": "Listar categorías",
          "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/categories", "description": "GET /categories; lista ordenada por nombre e id." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "Desactivar categoría",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}/deactivate", "description": "POST /categories/{id}/deactivate." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().active).to.eql(false);"] } }]
        },
        {
          "name": "Activar categoría",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}/activate", "description": "POST /categories/{id}/activate." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "pm.expect(pm.response.json().active).to.eql(true);"] } }]
        }
      ]
    },
    {
      "name": "03 - Products",
      "description": "Las nueve operaciones reales del controlador de productos.",
      "item": [
        {
          "name": "Crear producto",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"sku\": \"NS-REF-{{runId}}\",\n  \"name\": \"Producto Ref {{runId}}\",\n  \"description\": \"Producto de referencia\",\n  \"price\": 19.90,\n  \"stock\": 10,\n  \"imageUrl\": \"https://example.test/ref.jpg\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/products", "description": "POST /products; precio positivo y stock no negativo." },
          "event": [{ "listen": "test", "script": { "type": "text", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');", "const body = pm.response.json();", "pm.expect(body.id).to.be.a('number').and.above(0); pm.expect(body.active).to.eql(true); pm.expect(pm.response.headers.get('Location')).to.be.ok;", "pm.environment.set('productId', String(body.id)); pm.environment.set('sku', body.sku);"] } }]
        },
        {
          "name": "Actualizar producto",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"sku\": \"NS-REF-{{runId}}\",\n  \"name\": \"Producto Ref Actualizado\",\n  \"description\": \"Descripción actualizada\",\n  \"price\": 20.00,\n  \"imageUrl\": \"https://example.test/ref-updated.jpg\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/products/{{productId}}", "description": "PUT /products/{id}; no modifica stock." },
